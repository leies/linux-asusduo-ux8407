#!/bin/bash
# Keep a Windows 11 Limine chainload entry after limine-update rebuilds.
# Windows lives on its own ESP (not the Omarchy /boot ESP), so FIND_BOOTLOADERS
# cannot see bootmgfw.efi. Chainload it by GPT PARTUUID.
set -euo pipefail

CONF="${ESP_PATH:-/boot}/limine.conf"
[[ -f $CONF ]] || exit 0

if grep -q 'bootmgfw.efi' "$CONF"; then
  exit 0
fi

find_windows_partuuid() {
  local from_nvram=""
  if command -v efibootmgr >/dev/null 2>&1; then
    from_nvram=$(efibootmgr -v 2>/dev/null | awk '
      /Windows Boot Manager/ {
        if (match($0, /HD\([0-9]+,GPT,[0-9a-fA-F-]+/)) {
          split(substr($0, RSTART, RLENGTH), a, ",")
          print a[3]
          exit
        }
      }')
    if [[ -n ${from_nvram:-} && -e /dev/disk/by-partuuid/$from_nvram ]]; then
      printf '%s\n' "$from_nvram"
      return 0
    fi
  fi

  python3 - <<'PY'
import json, subprocess, sys

out = subprocess.check_output(
    ["lsblk", "-J", "-o", "NAME,FSTYPE,LABEL,PARTLABEL,PARTUUID,MOUNTPOINT"],
    text=True,
)
devs = []

def walk(nodes):
    for n in nodes:
        devs.append(n)
        walk(n.get("children") or [])

walk(json.loads(out)["blockdevices"])
boot = {n.get("partuuid") for n in devs if n.get("mountpoint") == "/boot"}

def is_vfat(n):
    return (n.get("fstype") or "").lower() in {"vfat", "fat32", "fat"}

def skip(n):
    label = (n.get("label") or "").upper()
    partlabel = (n.get("partlabel") or "").upper()
    return n.get("partuuid") in boot or label == "OMARCHY_EFI" or partlabel == "OMARCHY_EFI"

candidates = []
for n in devs:
    if not n.get("partuuid") or not is_vfat(n) or skip(n):
        continue
    label = (n.get("label") or "").upper()
    partlabel = (n.get("partlabel") or "")
    score = 0
    if label == "SYSTEM":
        score += 4
    if partlabel == "EFI system partition":
        score += 3
    if "EFI" in partlabel.upper() or "ESP" in label:
        score += 1
    candidates.append((score, n["partuuid"]))

candidates.sort(reverse=True)
if candidates and candidates[0][0] > 0:
    print(candidates[0][1])
    sys.exit(0)
sys.exit(1)
PY
}

PARTUUID="$(find_windows_partuuid || true)"
if [[ -z ${PARTUUID:-} ]]; then
  echo "80-windows-11-entry: no Windows ESP found; skip" >&2
  exit 0
fi

printf '\n/Windows 11\n    comment: Windows 11\n    comment: order-priority=40\n    protocol: efi\n    path: uuid(%s):/EFI/Microsoft/Boot/bootmgfw.efi\n' "$PARTUUID" >>"$CONF"
echo "80-windows-11-entry: added Windows 11 (PARTUUID=$PARTUUID)"
